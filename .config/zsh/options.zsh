# ============================================
# История команд
# ============================================
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY              # Общая история между терминалами
setopt HIST_IGNORE_DUPS           # Не сохранять дубликаты
setopt HIST_IGNORE_SPACE          # Игнорировать команды с пробелом в начале
setopt HIST_VERIFY                # Показать команду перед выполнением из истории
setopt HIST_EXPIRE_DUPS_FIRST     # Удалять дубликаты первыми
setopt HIST_FIND_NO_DUPS          # Не показывать дубликаты при поиске

# ============================================
# Навигация
# ============================================
setopt AUTO_CD                    # cd без написания cd
setopt AUTO_PUSHD                 # Автоматический pushd
setopt PUSHD_IGNORE_DUPS          # Не дублировать в стеке директорий
setopt PUSHD_SILENT               # Не печатать стек после pushd/popd

# ============================================
# Коррекция опечаток
# ============================================
# Для dev-команд вроде fd/rg/gcf/gbr автоматическая коррекция чаще мешает,
# чем помогает, поэтому держим её выключенной.
unsetopt CORRECT
unsetopt CORRECT_ALL
